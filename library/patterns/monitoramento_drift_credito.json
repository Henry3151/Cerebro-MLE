    "roadmap": [
      {
        "title": "Contrato de dados e quarentena",
        "components": [
          "fonte",
          "contrato",
          "quarentena"
        ],
        "why": "Sem dados confiáveis, qualquer métrica de drift vira ruído.",
        "done_when": "Um lote defeituoso é bloqueado e as linhas inválidas vão para a quarentena com o motivo.",
        "sources": []
      },
      {
        "title": "Privacidade desde a entrada",
        "components": [
          "pseudonimizacao",
          "gate_features",
          "auditoria"
        ],
        "why": "Dados pessoais precisam sair do fluxo antes de qualquer treino ou log.",
        "done_when": "Nenhum identificador direto aparece em features, logs ou relatórios.",
        "sources": []
      },
      {
        "title": "Modelo base e registro",
        "components": [
          "referencia",
          "treino",
          "registry"
        ],
        "why": "O monitoramento compara a produção com uma referência e um modelo conhecidos.",
        "done_when": "Modelo registrado como champion com métricas, hash dos dados e limiar por custo.",
        "sources": []
      },
      {
        "title": "Observabilidade mínima",
        "components": [
          "logs",
          "metricas"
        ],
        "why": "Antes de detectar drift, cada execução precisa deixar rastro.",
        "done_when": "Cada estágio emite log estruturado com trace_id e métricas de duração e volume.",
        "sources": []
      },
      {
        "title": "Detecção de drift",
        "components": [
          "producao",
          "gates_prod",
          "drift_stats",
          "relatorios"
        ],
        "why": "Com referência e produção separadas, já dá para medir mudança.",
        "done_when": "Drift aparece nas variáveis alteradas e não aparece nas variáveis de controle.",
        "sources": []
      },
      {
        "title": "Alertas e dashboard",
        "components": [
          "alertas",
          "dashboard"
        ],
        "why": "Detectar sem avisar ninguém não muda nada.",
        "done_when": "Alertas com prioridade, deduplicação e runbook; dashboard executivo, gestão e analítico.",
        "sources": []
      },
      {
        "title": "Resposta governada",
        "components": [
          "politica",
          "challenger",
          "fairness"
        ],
        "why": "Com drift confirmado, escolher a resposta proporcional e segura.",
        "done_when": "Challenger só é promovido se passar em AUC, calibração, custo e fairness.",
        "sources": []
      },
      {
        "title": "Análise de causa",
        "components": [
          "causal"
        ],
        "why": "Explicar se a perda veio de mudança de população ou de conceito orienta a correção.",
        "done_when": "Relatório separa o efeito de covariate shift do efeito de concept drift.",
        "sources": []
      }
    ],
    "assumptions": [
      "Rótulos (inadimplência) chegam com atraso de alguns meses."
    ],
    "risks": [
      "Retreinar com rótulos ainda incompletos gera viés de sobrevivência.",
      "Fairness pode piorar depois do drift; medir por janela, não só no treino."
    ]
  }
